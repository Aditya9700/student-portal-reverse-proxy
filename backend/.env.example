# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace <username>, <password>, and cluster details with your MongoDB Atlas or local MongoDB connection URI
# Ensure the database name in the URI is set to student_portal
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/student_portal?retryWrites=true&w=majority

# JWT Authentication Config
# Provide a strong, unique secret key for signing JWTs
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration
# Origin URL of the frontend React application
CLIENT_URL=http://localhost:5173
